PORT=3000
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-07
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_metafields,write_products
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
EXPORT_WEBHOOK_URL=https://example.com/order-export
APP_BASE_URL=https://your-backend.example.com

# Finance Gateway placeholders. Set the real values as Supabase Edge Function
# secrets. Never commit them. The default path is client credentials: the
# gateway caches a short-lived access token in finance_oauth_tokens and stores
# no refresh token. Leave the redirect and state lines empty on that path.
FORTNOX_CLIENT_ID=replace-with-fortnox-client-id
FORTNOX_CLIENT_SECRET=replace-with-fortnox-client-secret
FORTNOX_TENANT_ID=replace-with-numeric-tenant-id
# Optional. Only for the admin HTTP routes. SQL bootstrap does not need it.
FINANCE_ADMIN_TOKEN=replace-with-long-random-admin-token
# Fallback authorization-code path only. Unused when FORTNOX_TENANT_ID is set.
FORTNOX_REDIRECT_URI=https://localhost/fortnox-callback
FORTNOX_OAUTH_STATE=
