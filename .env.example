PORT=3000
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-07
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_metafields,write_products
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
# Hosted Edge Functions already receive SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Set SHOPIFY_WEBHOOK_SECRET for the function with `supabase secrets set` after review.
# Never commit real values. See docs/shopify-supabase-sync.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
EXPORT_WEBHOOK_URL=https://example.com/order-export
APP_BASE_URL=https://your-backend.example.com
